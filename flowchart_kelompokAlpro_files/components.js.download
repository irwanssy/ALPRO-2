%;\n\tfont-size: 12px ;\n}\n\n.dark{\n\tbackground-color: #2a2a2a;\n}\n.helpContainer{\n\tpadding: 0px 10px;\n\theight: 100%;\n\tbox-sizing: border-box !important;\n}\n.search-container{\n\tposition: relative;\n\theight: 30px;\n\t/* margin-bottom: 10px;  replaced by padding-bottom */\n\tborder: 1px solid rgb(218,218,218);\n\tborder-radius: 3px;\n\tbackground-color: white;\n}\n.search-text{\n\ttext-indent: 25px;\n\twidth: 100%;\n\tborder: none;\n\theight: 100%;\n\tpadding: 0px;\n\t/* font-size: 14px; */\n\tvertical-align: middle;\n\tline-height: 30px;\n}\n.search-text::placeholder{\n\tcolor: #9eaab3;\n}\n.input-search-icon{\n\tmargin-left: 5px;\n\tfont-size: 15px;\n\tposition: absolute;\n\tpadding-top: 6px;\n\tcursor: pointer;\n\tfont-weight: 700;\n}\n.input-clear-button{\n\tmargin-right: 5px;\n\tfont-size: 20px;\n\tposition: absolute;\n\tright: 0px;\n\tcursor: pointer;\n\tfont-weight: 700;\n}\n\n.categorySelect{\n\tmargin-top: 10px;\n\tborder: none;\n\twidth: 100%;\n\tbox-sizing: border-box;\n\t/* padding: 5px 20px 5px 5px; */\n\tpadding: 6px 20px 6px 5px;\n\tcursor: pointer;\n\tborder: 1px solid rgb(216,216,216);\n\tborder-radius: 3px;\n\tbackground-color: #fff;\n\tcolor: black;\n}\n .categorySelect_dark{\n\tmargin-top: 10px;\n\tborder: none;\n\twidth: 100%;\n\tbox-sizing: border-box;\n\t/* padding: 5px 20px 5px 5px; */\n\tpadding: 6px 20px 6px 5px;\n\tcursor: pointer;\n\tborder: 1px solid rgb(216,216,216);\n\tborder-radius: 3px;\n\tbackground-color: #2f3642;\n\tcolor: #ccc;\n}\n.itemList{\n\tmargin-top: 6px;\n\t/* height: 85%;\n\toverflow: auto; */\n}\n/* .leftItemList{\n\tposition:fixed;\n\tbackground-color: white;\n\tz-index: 2;\n\twidth: 240px;\n\tleft: calc((30%)/2 - 240px);\n\ttop: 10%;\n\theight: 80%;\n\toverflow: auto;\n} */\n.item{\n\tdisplay: flex;\n\tpadding: 4px 4px 4px 0px;\n\tmargin-bottom: 5px;\n\tcursor: pointer;\n\tfont-weight: 500;\n\tfont-size: 12px;\n}\n.item-dark{\n\tdisplay: flex;\n\tpadding: 4px 4px 4px 0px;\n\tmargin-bottom: 5px;\n\tcursor: 