0, 0, 0.75);\n    left: 0;\n    right: 0;\n    top: 0;\n    bottom: 0;\n    z-index: 30;\n    display: flex;\n    align-items: center;\n}\n\n.flipbook-permission-text {\n    font-size: 20px;\n    width: 100%;\n    text-align: center;\n    color: #D2D2D2;\n}\n\n.flipbook-textLayer {\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 0;\n    bottom: 0;\n    overflow: hidden;\n    opacity: .2;\n    line-height: 1;\n}\n.flipbook-textLayer span {\n    color: transparent;\n    position: absolute;\n    white-space: pre;\n    cursor: text;\n    transform-origin: 0% 0%;\n}\n\n.flipbook-textLayer, .flipbook-annotationLayer {\n    transform-origin: 0 0;\n    transform: translateX(var(--offset-x, 0));\n}\n.flipbook-textLayer[data-main-rotation="90"], .flipbook-annotationLayer[data-main-rotation="90"] {\n    transform: translateX(var(--offset-x, 0)) rotate(90deg) translateY(-100%);\n}\n.flipbook-textLayer[data-main-rotation="180"], .flipbook-annotationLayer[data-main-rotation="180"] {\n    transform: translateX(var(--offset-x, 0)) rotate(180deg) translate(-100%, -100%);\n}\n.flipbook-textLayer[data-main-rotation="270"], .flipbook-annotationLayer[data-main-rotation="270"] {\n    transform: translateX(var(--offset-x, 0)) rotate(270deg) translateX(-100%);\n}\n\n.flipbook-annotationLayer {\n    position: absolute;\n    top: 0;\n    left: 0;\n}\n.flipbook-annotationLayer section {\n    position: absolute;\n    text-align: initial;\n}\n.flipbook-annotationLayer .linkAnnotation > a, .flipbook-annotationLayer .buttonWidgetAnnotation.pushButton > a {\n    position: absolute;\n    font-size: 1em;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n}\n.flipbook-annotationLayer .linkAnnotation > a:hover, .flipbook-annotationLayer .buttonWidgetAnnotation.pushButton > a:hover {\n    background-color: currentColor;\n    opacity: 0.2;\n}\n\n.flipbook-inlinesvg-container {\n    width: 100%;\n    height: 100%;\n}\n\n.flipbook-inlinesvg-container .hiddenShapeNode {\n    visibility: hidden !important;\n}\n\n.flipbook-inlinesvg-container svg:not([free-from-container=true]) {\n    width: 100%;\n    height: 100%;\n}\n.flipbook-inlinesvg-container svg p {\n    /** avoid outside style.css (#82539) */\n    font-size: inherit;\n    font-weight: inherit;\n    margin: inherit;\n}\n.flipbook-tocItem .omitTocItemBtn {\n\tdisplay: none;\n}\n.flipbook-tocItem:hover .omitTocItemBtn {\n\tdisplay: flex;\n}\n.flipbook-tocItem .pageName {\n    color: #3070f0;\n    text-decoration: underline;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    overflow: hidden;\n}\n.flipbook-tocItem .dotdotdot-container {\n    flex-grow: 1;\n    flex-shrink: 1;\n    margin-left: 1rem;\n    margin-right: 1rem;\n    position: relative;\n    display: flex;\n    justify-content: center;\n}\n.flipbook-tocItem .dotdotdot-container .dotdotdot {\n    height: 1px;\n    border-top: dotted 1px #505050;\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 50%;\n}\n.flipbook-tocItem .pageNumber {\n    white-space: nowrap\n}\n\n.flipbook-blankPage .deleteBtn, \n.flipbook-blankPage .movePrevBtn, \n.flipbook-blankPage .moveNextBtn, \n.flipbook-tocPage .deleteBtn, \n.flipbook-tocPage .movePrevBtn, \n.flipbook-tocPage .moveNextBtn {\n    display: none;\n}\n.flipbook-blankPage:hover .deleteBtn, \n.flipbook-blankPage:hover .movePrevBtn, \n.flipbook-blankPage:hover .moveNextBtn, \n.flipbook-tocPage:hover .deleteBtn, \n.flipbook-tocPage:hover .movePrevBtn, \n.flipbook-tocPage:hover .moveNextBtn {\n    display: flex;\n}\n\n.flipbook-panning-on {\n    cursor: grab;\n    /* user-select: none; (#87852, 2022-03-22 14:10) */\n}\n.flipbook-panning-on svg image {\n    pointer-events: none; /* (#87794) */\n}\n.flipbook-panning-on .flipbook-textLayer, \n.flipbook-panning-on .flipbook-textLayer span {\n    cursor: grab;\n    pointer-events: none; /* (#87929) */\n}\n\n.flipbook-toolbar .zoom-bar {\n    z-index: 100;\n    opacity: .7;\n    transition: .25s; /* seems switching opacity will become better*/\n}\n.flipbook-toolbar .zoom-bar:hover {\n    opacity: 1;\n}\n\n.flipbook-toolbar .zoom-bar .bp3-slider {\n    min-width: 200px;\n    margin-left: .5rem; /* avoid overlap with other button */\n    margin-right: .5rem;\n}\n.flipbook-toolbar .zoom-bar .bp3-slider .bp3-slider-track {\n    top: 50%;\n    transform: translate(0, -50%);\n}\n.flipbook-toolbar .zoom-bar .bp3-slider .bp3-slider-track .bp3-slider-progress {\n    background: #505050;\n}\n.flipbook-toolbar .zoom-bar .bp3-slider .bp3-slider-track .bp3-slider-progress.bp3-intent-primary {\n    background: #c0c0c0;\n}\n.flipbook-toolbar .zoom-bar .bp3-slider .bp3-slider-handle {\n    top: 50%;\n    transform: translate(4px, -50%); /* 4px: blueprintjs will translate 8px, and now we set 8px width; Specify 4px to adjust it to be center. */\n    background: #c0c0c0;\n    width: 8px; /* smaller handle, avoid overlap with zoom button */\n    height: 16px;\n}\n\n.flipbook-toolbar .flipbook-zoom-combo .bp3-popover-appear-done, \n.flipbook-toolbar .flipbook-zoom-combo .bp3-popover-enter-done {\n    z-index: 10000; /* make sure won\'t be overlapped by book pages\' z-index */\n}\n.flipbook-toolbar .flipbook-zoom-combo .scrollable-popup .bp3-menu {\n    overflow: auto;\n    min-width: 5rem;\n    max-height: 15rem;\n}\n.flipbook-toolbar/*.touch-device (#88679)*/ .bp3-button {\n    border-radius: 0px; /* (#88408) */\n}\n\n.moderator-opt .bp3-menu {\n    min-width: unset;\n}\n\n\n.flipbook-overlay {\n    z-index: 10000; /* make sure won\'t be overlapped by book pages\' z-index */\n}\n\n.flipHints {\n    position: absolute;\n    top: -2.5rem;\n    right: 0;\n    height: 2.5rem;\n    opacity: 0;\n\n    animation-name: stay-and-fade-out;\n    animation-duration: 10s;\n}\n.flipHints .flipHints-msg {\n    background: #e0e0e0;\n    color: #404040;\n    height: 2rem;\n    border-radius: .5rem;\n    padding: 0 .5rem;\n    display: flex;\n    align-items: center;\n}\n.flipHints .flipHints-anchor {\n    background: #e