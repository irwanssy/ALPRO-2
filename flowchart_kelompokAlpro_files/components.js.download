ustify-content: center;\n\twidth: fit-content;\n\tuser-select: none;\n}\n.bp3-dark .vpResourceCentricContainer {\n\t/* simulate Navbar's styles */\n\tbackground-color: #394b59;\n\tcolor: #ccc; /*(#88508)*/\n\tborder: 1px solid #e8e8e8;\n}\n.bp3-dark .vpResourceCentricContainer .twitter-picker {\n\tbackground-color: #394b59 !important; /* make sure color-picker's Twitter can be shown in dark-mode */\n}\n.bp3-dark .vpResourceCentricContainer .twitter-picker input {\n\t/* override the padding:5 from dark.css's \".geEditor input:not(.form-control):not(.bp3-input)\" */\n\tpadding-top: 1px;\n\tpadding-bottom: 1px;\n}\n.vpResourceCentricContainer .twitter-picker input, \n.vpResourceCentricContainer-internalPortal .twitter-picker input {\n\t/* custom color field is too long (100px), set smaller */\n\tmax-width: 60px;\n}\n.vpResourceCentricContainer.inside {\n\tbackground-color: #fafbfc;\n}\n.bp3-dark .vpResourceCentricContainer.inside {\n\tbackground-color: #5c6d7e;\n}\n.vpResourceCentricContainer.cell-north-west {\n\tborder-radius: 5px;\n\tbackground-color: white;\n\tpadding: 5px 0px;\n\t/* box-sizing: border-box; */\n}\n.vpResourceCentricContainer .twitter-picker span div {\n\tborder: solid 1px #cacaca; /* border for white color in light-theme */\n\tmargin: 0 4px 4px 0 !important; /* original bp design is 0px on margin-left/top  6px on margin-right/bottom; need reduce our border */\n}\n.bp3-dark .vpResourceCentricContainer .twitter-picker span div {\n\t /* rollback to original bp design*/\n\tborder: 1px solid grey;\n\tmargin: 0 4px 6px 0 !important;\n}\n.vpResourceCentricContainer .twitter-picker span div[title=transparent] div {\n\tborder: none;\n\tmargin: 0 !important;\n\tbox-shadow: none !important;\n}\n\n.twitter-picker span div[title=transparent] {\n\tbackground-color: white !important;\n}\n\n.customMenuItemTextComponent {\n\tfont-size: .75rem !important;\n}\n.vpResourceCentricContainer button.bp3-disabled {\n\topacity: .3; /* try to make the disabled button looks disabled */\n\tcursor: default !important; /* #77920 */\n}\n\n.vpResourceCentricContainer.north, \n.vpResourceCentricContainer.north-west, \n.vpResourceCentricContainer.north-east {\n\tflex-direction: row;\n\t/* simulate Navbar's styles */\n\t/* border-top-left-radius: 6px;\n\tborder-top-right-radius: 6px; */\n}\n.vpResourceCentricContainer.south, \n.vpResourceCentricContainer.south-west, \n.vpResourceCentricContainer.south-east {\n\tflex-direction: row;\n\t/* simulate Navbar's styles */\n\t/* border-bottom-left-radius: 6px;\n\tborder-bottom-right-radius: 6px; */\n}\n.vpResourceCentricContainer.west, \n.vpResourceCentricContainer.west-north, \n.vpResourceCentricContainer.west-south {\n\tflex-direction: column;\n\t/* simulate Navbar's styles */\n\t/* border-top-left-radius: 6px;\n\tborder-bottom-left-radius: 6px; */\n}\n.vpResourceCentricContainer.west-north {\n\t/* assume westNorth is for Authoring, show it in pink fill-color */\n\tbackground: pink;\n}\n.vpResourceCentricContainer.east, \n.vpResourceCentricContainer.east-north, \n.vpResourceCentricContainer.east-south {\n\tflex-direction: column;\n\t/* simulate Navbar's styles */\n\t/* border-top-right-radius: 6px;\n\tborder-bottom-right-radius: 6px; */\n}\n.vpResourceCentricContainer .bp3-button {\n\t/* simulate Navbar's styles */\n\t/* width: 20px;\n\theight: 20px;\n\tpadding: 0; */\n\tmin-width: max-content; /* make sure button can show its caption or icon */\n}\n.vpResourceCentricContainer .bp3-button {\n\tpadding: 10px;\n}\n\n.vpResourceCentricContainerCharacter3d .bp3-button {\n\tpadding: 6px;\n\tmargin: 0px 2px;\n}\n\n.vpResourceCentricContainer .bp3-popover2-target {\n\tdisplay: flex; /* to make popup button's height to be 100% of vpResourceCentricContainer */\n}\n.vpResourceCentricContainer .bp3-popover2 .bp3-menu {\n\tbox-shadow: 0 0 0 1px rgb(16 22 26 / 10%), 0 0 0 rgb(16 22 26 / 0%), 0 1px 1px rgb(16 22 26 / 20%); /* blueprintjs.css missing popup menu's box-shadow (border), add back it manually */\n\tmin-w