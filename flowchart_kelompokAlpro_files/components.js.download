px;\n\toverflow:hidden;\n\tclip:rect(0,0,0,0);\n}\n\n.filedContainer #ticketfullname{\n\tmargin-top:10px;\n}\n\n\n.filedContainer .button{\n\tdisplay:block;\n\tvertical-align:middle;\n\ttext-align:center;\n\tmargin:auto;\n\t/* cursor:pointer;\n\tbackground-color:#45aaf2;\n\tborder:2px solid #fff;\n\tcolor:#fff; */\n\tfont-size:.9em;\n\tfont-weight:400;\n\tpadding:0.625rem 1rem !important;\n\t/* border-radius:40px; */\n}\n\n.productDetailsSection hr{\n\tmargin:0px;\n}\n\n.was-validated .form-control:invalid{\n\tborder-color:#e96b77;\n\tbackground-color:#f9ecea;\n}\n\n.was-validated .form-control:invalid::placeholder{\n\tcolor:#dc3545;\n}\n\n.invalid-feedback{\n\tcolor:#dc3545;\n\tdisplay:none;\n}\n\n\n.was-validated .form-control:invalid~.invalid-feedback{\n\tdisplay:block;\n}\n\n/* Support Form Result */\n.boxcontainerlabel{\n\tpadding:5px 0;\n\tborder-bottom:1px solid #cfd4d6;\n\tfont-size:20px;\n\tfont-weight: 600;\n\tline-height: 1.4;\n}\n\n.boxcontainercontent{\n\tfont-size:15px;\n\tcolor: #4c5156;\n\tmargin-top:10px;\n}\n\n.boxcontainercontent td{\n\tword-break: break-word;\n\twidth:150px;\n}\n\n.hiddenResult{\n\tpadding:10px;\n}\n\n/* Overlay For Help Panel Content */\n.overlay-image-container{\n\tdisplay:block;\n\tposition:fixed;\n\twidth:80%;\n\theight:80%;\n\ttop:10%;\n\tleft:10%;\n\tz-index:1;\n}\n\n.overlay-image-container .overlay-image{\n\twidth:100%;\n}\n\n.overlay-image-container .overlay-closeBtn{\n\ttext-align: right;\n\tdisplay:block;\n\tposition: relative;\n\theight:24px;\n\twidth:100%;\n\tbackground:#2f3642;\n\tcursor: grabbing;\n}\n\n.overlay-image-container .overlay-image-subLayer{\n\twidth:100%;\n\theight:100%;\n\tpadding:50px;\n}\n\n.overlay-image-container .overlay-closeBtn .buttonImage{\n\tcursor: pointer;\n\topacity:0.65;\n}\n\n.overlay-image-container .overlay-closeBtn .buttonImage:hover{\n\topacity:1;\n}\n\n/* responsive */\n@media (max-width:760px){\n\t.news-panel-overlay-container{\n\t\twidth:100%;\n\t}\n}\n\n\n/* In WebDiagram */\n.di